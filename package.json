{
  "name": "414-single-round",
  "private": true,
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:rules": "tsc -p tsconfig.rules.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "verify": "npm run typecheck:rules && npm run typecheck:web && npm run typecheck:minigame && npm test",
    "build:minigame": "vite build --config vite.minigame.config.ts",
    "typecheck:minigame": "tsc -p tsconfig.minigame.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
