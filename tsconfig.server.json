{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": [
    "server/**/*.ts",
    "client/assets/scripts/core/**/*.ts",
    "client/assets/scripts/ai/**/*.ts",
    "client/assets/scripts/ui/**/*.ts",
    "client/assets/scripts/online/**/*.ts"
  ]
}
