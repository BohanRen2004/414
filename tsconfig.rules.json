{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["client/assets/scripts/core/**/*.ts", "client/assets/scripts/ai/**/*.ts", "client/assets/scripts/app/**/*.ts", "client/assets/scripts/ui/table-view-model.ts", "tests/**/*.ts", "vitest.config.ts"]
}
